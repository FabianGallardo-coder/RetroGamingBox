<?xml version="1.0" encoding="UTF-8"?>
<theme>
    <format_version>4</format_version>
    <view name="system">
        <header><text name="systemName">{system.name}</text></header>
        <grid name="gamegrid"><itemSize>0.22 0.26</itemSize><padding>0.02</padding></grid>
    </view>
    <variables>
        <menuBackground>#e60012</menuBackground>
        <menuText>#ffffff</menuText>
        <primaryColor>#00a0e9</primaryColor>
        <selectedColor>#00d4ff</selectedColor>
    </variables>
</theme>
