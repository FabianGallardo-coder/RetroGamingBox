# =====================================================
# RetroGamingBox .gitignore
# =====================================================

# Cores libretro (se descargan con install_cores.sh)
cores/*.so
cores/*.info

# BIOS (legales pero no incluirlos por tamaño)
bios/*
!bios/.gitkeep

# Saves y states (personal, no incluir)
saves/
*.sav
*.state*
*.png (savestates)

# Logs
logs/*.log
*.log

# Cache y temporales
__pycache__/
*.pyc
*.pyo
*.tmp
*.temp
.cache/
.temp/

# ROMs (no incluir en el repo)
roms/
/home/

# Medien downloaded
media/downloads/
media/videos/
media/music/

# Configuración personal de RetroArch
configs/retroarch/retroarch.cfg

# Configuración personal de ES-DE
.config/es-de/
.local/share/es-de/

# Imágenes de scraper (regenerables)
thumbnails/

# Python scripts de pruebas
check_archives.py
dry_run_*.py
final_organizer*.py
organize_roms.py
rom_organizer*.py
test_extract.py
prometheus

# Archivos de salida de pruebas
dry_run_*.txt
dry_run_*.log
dry_run_summary.py
problematic_archives.csv
organization.log

# OS files
.DS_Store
Thumbs.db

# git
.git/
.gitignore

# AppImage de ES-DE (se descarga con install_esde.sh)
es-de/*.AppImage
es-de/*.txt
es-de/*.desktop